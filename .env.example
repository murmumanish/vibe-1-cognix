# ====================================================================
# Internal Mobility Desk - Environment Configuration
# ====================================================================

# 1. MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/internal_mobility_desk?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internal_mobility_desk?retryWrites=true&w=majority

# 2. Company Configuration
COMPANY_TIMEZONE=Asia/Kolkata
RIDER_INVITATION_CODE=TOTO_LAWAZIA_2026

# 3. Vehicle & Scheduling Parameters
VEHICLE_SEAT_CAPACITY=4
PICKUP_TOLERANCE_MINUTES=0
PICKUP_HANDLING_BUFFER_MINUTES=3
DROPOFF_HANDLING_BUFFER_MINUTES=2
SAFETY_BUFFER_MINUTES=5

# 4. Routing Provider Configuration
# Mode: "demo" (schematic Cartesian x, y Euclidean) or "geographic" (OSRM road routing)
ROUTING_MODE=demo
OSRM_BASE_URL=https://router.project-osrm.org
DEMO_SPEED_UNITS_PER_MINUTE=15

# 5. Security & Session Settings
# Generate a random 32+ character string in production
SESSION_SECRET=super_secret_session_key_internal_mobility_desk_2026
SESSION_EXPIRY_HOURS=24
NODE_ENV=development
